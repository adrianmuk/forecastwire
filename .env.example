# Register at https://docs.panta.market/ and create a pk_test_ or pk_live_ key.
# Keep it on the server. Never commit the real value.
PANTA_API_KEY=
# Set a stable private secret on a public deployment so receipt links survive Panta key rotation.
# FORECASTWIRE_RECEIPT_SECRET=generate-a-long-random-value
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_SOLANA_CLUSTER=mainnet-beta
PORT=3000
# Optional for local Windows use if binding 0.0.0.0 is denied:
# HOST=127.0.0.1
